# ================================================================
# REI Grove Outreach — Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# In Vercel: Project Settings -> Environment Variables (same keys).
# ================================================================

# ---- Supabase (REQUIRED) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic Claude (REQUIRED — scoring assist, outreach drafting, reply classification) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Microsoft 365 / Outlook (REQUIRED — send from + monitor a real Outlook inbox) ----
# Register an app in Azure AD (see DEPLOY.md). Needs delegated Mail.Send, Mail.Read,
# Mail.ReadWrite, User.Read, offline_access.
MS365_CLIENT_ID=your-azure-app-client-id
MS365_CLIENT_SECRET=your-azure-app-client-secret
MS365_TENANT_ID=your-tenant-id-or-common
MS365_REDIRECT_URI=https://your-app.vercel.app/api/auth/microsoft/callback

# ---- Ahrefs (OPTIONAL — domain authority / traffic signals used in scoring) ----
# Leave blank to skip Ahrefs enrichment; scoring will just note the dimension as
# "no data" rather than failing.
AHREFS_API_KEY=your-ahrefs-api-key

# ---- n8n ingestion (REQUIRED if you want n8n to push prospects/trigger sync) ----
# Any n8n workflow that POSTs to /api/webhooks/n8n/prospects or calls
# /api/graph/sync must send this exact value in the `x-n8n-secret` header.
N8N_WEBHOOK_SECRET=choose-a-long-random-string

# ---- Apollo.io (OPTIONAL — B2B contact lookup for company/partner-type prospects) ----
APOLLO_API_KEY=your-apollo-api-key

# ---- App config ----
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
REI_GROVE_SENDER_NAME=REI Grove Partnerships
