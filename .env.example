# ================================================================
# REI Grove Outreach — Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# In Vercel: Project Settings -> Environment Variables (same keys).
# ================================================================

# ---- Neon Postgres (REQUIRED) ----
# Pooled connection string from your Neon project (Dashboard -> Connection Details).
# Server-only — never prefix with NEXT_PUBLIC_ or reference from a client component.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---- Anthropic Claude (REQUIRED — scoring assist and outreach drafting) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Ahrefs (OPTIONAL — domain authority/traffic signals for scoring, and required for the
# Contacts search on Prospect Search) ----
# Leave blank to skip Ahrefs enrichment; scoring will just note the dimension as
# "no data" rather than failing, and Contacts will be disabled.
AHREFS_API_KEY=your-ahrefs-api-key

# ---- YouTube Data API (OPTIONAL — a second, free discovery source that finds real YouTube
# channels directly, separate from Ahrefs, and mines each channel's bio for a self-stated
# name or business contact email) ----
# Free: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> Create API key.
# Restrict the key to "YouTube Data API v3" specifically; leave Application restrictions on
# "None" (this is called server-side, not from a browser, so referrer/IP restrictions don't
# apply and will just break it). No billing account required for this quota tier (10,000 free
# units/day). Leave blank to disable the "YouTube channels" discovery mode.
YOUTUBE_API_KEY=your-youtube-data-api-key

# ---- Apollo (OPTIONAL — email enrichment for prospects found by Contacts/Podcast
# hosts/YouTube channels, most of which have a name but no contact info) ----
# app.apollo.io -> Settings -> API -> create a key. Leave blank to disable the "Find emails"
# bulk action on Prospect Search and the "Find email" button on a blocked Outreach draft —
# approved prospects with no email will still need one added by hand.
APOLLO_API_KEY=your-apollo-api-key

# ---- n8n ingestion (OPTIONAL — only needed if you want n8n to bulk-push prospects) ----
# Any n8n workflow that POSTs to /api/webhooks/n8n/prospects must send this
# exact value in the `x-n8n-secret` header.
N8N_WEBHOOK_SECRET=choose-a-long-random-string

# ---- App config (REQUIRED) ----
# Your deployed URL — used to build the unsubscribe link appended to outreach emails.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
